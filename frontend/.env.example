# Desenvolvimento: não é obrigatório — o Vite usa proxy /api → localhost:8000.
#
# Produção: copie este arquivo para .env.production antes do npm run build:
#   cp .env.example .env.production
# Edite VITE_API_URL para a URL pública da API (HTTPS, sem barra no final).

# VITE_API_URL=https://api.seudominio.com

# Landing comercial (mailto do CTA «Fale conosco» — #515 / #516)
# VITE_LANDING_CONTACT_EMAIL=contato@deskrudder.com.br
# VITE_MARKETING_SITE_URL=https://deskrudder.com.br

# Control-plane SaaS (só na instância comercial deskrudder.com.br):
# mostra atalho «Painel de licenças» na landing. Combinar com SAAS_CONTROL_PLANE=true no backend.
# VITE_SAAS_CONTROL_PLANE=true

# Single-tenant (produção por cliente): padrão — não envia X-Dx-Tenant-Id
# VITE_DEFAULT_TENANT_ID=1
# VITE_CLIENT_APP_HOST=cliente01.deskrudder.com.br
#
# Multi-tenant legado (dev com vários clientes no mesmo Postgres):
# VITE_MULTI_TENANT=true
# VITE_CONNECT_APP_BASE_DOMAIN=deskrudder.com.br

# App Android Capacitor (#735 / #736): `npm run build:android` não exige VITE_API_URL
# (o login pede a conta / slug). Opcional para debug local (emulador 10.0.2.2 ou IP LAN).
# CORS da instância tem de incluir https://localhost. Ver docs/MOBILE_CAPACITOR.md.
