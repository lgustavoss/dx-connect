# Copie para .env:  cp .env.example .env  (desenvolvimento local)

ENVIRONMENT=development
DEBUG=false
DATABASE_URL=postgresql://dxconnect:dxconnect_secret@localhost:5432/dxconnect
# Desenvolvimento: 16+ caracteres. Produção: 32+ e valor aleatório forte.
SECRET_KEY=local-dev-secret-min-16-chars
ALGORITHM=HS256
# Desenvolvimento: até 60. Em ENVIRONMENT=production o app exige no máximo 30 (sessão curta / JWT).
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Separadas por vírgula. Em produção use apenas origens HTTPS reais do frontend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost

LOG_LEVEL=INFO

# --- Tenant (produção comercial: single-tenant por instância / Postgres dedicado) ---
# DX_CONNECT_MULTI_TENANT=false   # padrão; true só em dev legado (vários clientes no mesmo Postgres)
# DEFAULT_TENANT_ID=1
# CLIENT_APP_HOST=cliente01.deskrudder.com.br   # URL pública do painel (GET /tenant/atual)
# PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1   # validade do link «esqueci minha senha»
#
# --- Control-plane SaaS (só na instância comercial deskrudder.com.br) ---
# SAAS_CONTROL_PLANE=true   # habilita API /v1/saas/*
# SAAS_NOTIFY_EMAIL=comercial@deskrudder.com.br
# SAAS_TRIAL_DAYS=14
# SAAS_RENEWAL_ALERT_DAYS_BEFORE=14
# SAAS_PROVISION_BASE_DOMAIN=deskrudder.com.br
# SAAS_PROVISION_API_PORT_START=8001
# SAAS_PROVISION_EXEC_ENABLED=false   # true só no host com Docker/scripts
# SAAS_REPO_ROOT=/opt/dx-connect
#
# --- Multi-tenant legado (só se DX_CONNECT_MULTI_TENANT=true) ---
# CONNECT_APP_BASE_DOMAIN=deskrudder.com.br
# INBOUND_EMAIL_DOMAIN=notify.deskrudder.com.br

# --- E-mail transaccional (plataforma / Resend HTTP API) ---
# Uma conta Resend (ou equivalente) da operação — o cliente final NÃO configura API key no painel.
# RESEND_API_KEY=re_...
# TRANSACTIONAL_FROM_EMAIL=noreply@notify.deskrudder.com.br
# TRANSACTIONAL_FROM_NAME=DeskRudder
# SUPPORT_REPLY_TO_EMAIL=suporte@suaempresa.com.br
#
# --- Ingestão inbound (encaminhamento → tickets) ---
# EMAIL_INBOUND_WEBHOOK_SECRET=...
# RESEND_WEBHOOK_SECRET=whsec_...   # webhook Resend email.received → POST /v1/webhooks/resend-inbound
# INBOUND_EMAIL_DOMAIN=notify.deskrudder.com.br
# EMAIL_INBOUND_DEFAULT_EMPRESA_ID=1   # omitir = ticket sem empresa até triagem
# EMAIL_INBOUND_DEFAULT_SETOR_ID=1

# --- WhatsApp / Evolution (produção com docker-compose.prod.yml) ---
# API em network_mode: host chama a Evolution em 127.0.0.1:8080 (porta publicada pelo contentor).
# EVOLUTION_INTERNAL_BASE_URL=http://127.0.0.1:8080
# EVOLUTION_GLOBAL_API_KEY=<mesmo valor de AUTHENTICATION_API_KEY da Evolution; mín. 32 caracteres>
# DX_CONNECT_WEBHOOK_BASE_URL=https://api-cliente01.deskrudder.com.br
# EVOLUTION_POSTGRES_PASSWORD=<senha forte para o Postgres dedicado da Evolution>
# EVOLUTION_POSTGRES_USER=evolution
# EVOLUTION_POSTGRES_DB=evolution
# EVOLUTION_SERVER_URL=http://127.0.0.1:8080
#
# Desenvolvimento local (Docker Compose): valores injetados em docker-compose.yml no serviço backend.
#
# Ficheiros de mídia WhatsApp (path relativo ao cwd ou absoluto). Em Docker o cwd é /app — use volume em ./backend/data.
# WHATSAPP_MEDIA_DIR=data/whatsapp_media
# EVOLUTION_HTTP_MAX_ATTEMPTS=3
#
# --- Webhook de saída (ticket fechado, #119) ---
# TICKET_CLOSED_WEBHOOK_URL=https://integracao.exemplo.com/dx/ticket-closed
# TICKET_CLOSED_WEBHOOK_SECRET=segredo-compartilhado-para-hmac
# WEBHOOK_OUTBOX_WORKER_INTERVAL_SECONDS=15
#
# --- Web Push (VAPID) por instância / stack (#693) ---
# Gerar: python -c "from py_vapid import Vapid01; v=Vapid01(); v.generate_keys(); print(v.public_key.decode() if hasattr(v.public_key,'decode') else v.public_key)"
# WEB_PUSH_VAPID_PUBLIC_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY=
# WEB_PUSH_VAPID_SUBJECT=mailto:ops@deskrudder.com.br
# WEB_PUSH_WORKER_INTERVAL_SECONDS=5

# Cache IBGE (municípios): intervalo entre syncs em segundos e idade máxima (horas) antes de re-sync.
# IBGE_MUNICIPIOS_SYNC_INTERVAL_SECONDS=86400
# IBGE_MUNICIPIOS_MAX_AGE_HOURS=168

# --- Produção (Hostinger / DB externo), exemplo ---
# ENVIRONMENT=production
# DEBUG=false
# DATABASE_URL=postgresql://usuario:senha@host-da-hostinger:5432/nome_db?sslmode=require
# Se Postgres estiver no mesmo VPS e a API rodar com docker-compose.prod (network_mode: host), use 127.0.0.1 no host.
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# ALLOWED_HOSTS=api.seudominio.com,127.0.0.1
# SECRET_KEY=cole_aqui_hex_de_64_chars_ou_base64_forte
# CORS_ORIGINS=https://app.seudominio.com,https://www.seudominio.com
#
# Deploy produção (schema):
# - Subir API só após aplicar migrations no banco:  alembic upgrade head
#   (ex.: docker compose run --rm backend alembic upgrade head — ver docker-compose.)
# - Com ENVIRONMENT=production a API NÃO roda SQLAlchemy create_all nem seed automático;
#   evita conflito com Alembic e criação de admin padrão sem você querer.
# - Dados iniciais (status de ticket, primeiro admin): rode uma vez, com controle:
#     docker compose exec backend python -m app.seed
#   Em produção defina SEED_ADMIN_EMAIL e SEED_ADMIN_PASSWORD (mín. 8 caracteres) para criar o primeiro admin;
#   a conta nasce com must_change_password=true (troca obrigatória na primeira sessão).
#   Sem SEED_ADMIN_EMAIL (ou sem senha válida) o seed em produção não cria usuário admin automático.
#
# SEED_ADMIN_EMAIL=seu@email.com
# SEED_ADMIN_PASSWORD=

# Hostnames permitidos no header Host (TrustedHostMiddleware). Em produção liste o hostname da API e 127.0.0.1 se
# fizer healthcheck local. Não use * em produção.
# ALLOWED_HOSTS=api.seudominio.com,127.0.0.1
#
# Gunicorn: IPs que podem enviar X-Forwarded-* (padrão 127.0.0.1). Se o Nginx estiver noutro host, defina o IP do proxy.
# GUNICORN_FORWARDED_ALLOW_IPS=127.0.0.1
#
# JWT: só access token (sem refresh). Token em localStorage/sessionStorage é sensível a XSS — mantenha dependências
# atualizadas (npm audit no frontend), CSP no Nginx, e evite innerHTML com dados não confiáveis. Refresh em cookie
# httpOnly exige mudança maior de backend; avalie conforme o perfil de risco.
#
# Cabeçalhos extras (HSTS, CSP no HTML) e limit_req em /auth/login: ver deploy/nginx/README.md
