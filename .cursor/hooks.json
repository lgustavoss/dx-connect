{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "py -3 .cursor/hooks/block_main_branch.py",
        "matcher": "git |gh "
      }
    ],
    "afterFileEdit": [
      {
        "command": "py -3 .cursor/hooks/format_frontend.py"
      }
    ]
  }
}
