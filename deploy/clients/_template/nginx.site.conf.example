# Nginx — um cliente (app + API em subdomínios distintos).
# Padrão DeskRudder: {slug}.deskrudder.com.br + api-{slug}.deskrudder.com.br
# Copiar para /etc/nginx/sites-available/dx-connect-CLIENT_SLUG e ativar.
#
# Pré-requisitos:
#   - API em 127.0.0.1:CLIENT_API_PORT (docker compose deste cliente)
#   - SPA em FRONTEND_DIST (build com VITE_API_URL do cliente)

upstream dx_connect_api_CLIENT_SLUG {
    server 127.0.0.1:CLIENT_API_PORT;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name api-CLIENT_SLUG.BASE_DOMAIN;

    client_max_body_size 25M;

    location / {
        proxy_pass http://dx_connect_api_CLIENT_SLUG;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 60s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name CLIENT_SLUG.BASE_DOMAIN;

    root FRONTEND_DIST;
    index index.html;

    # Download do instalador Windows sem login no painel (Release estável no GitHub).
    location = /acesso-remoto/download {
        return 302 https://github.com/lgustavoss/dx-connect/releases/download/acesso-remoto-windows-flutter/DeskRudder-AcessoRemoto-Flutter.exe;
    }

    # Setup DeskRudder (atendente) — link amigável /app/download.
    location = /app/download {
        return 302 https://github.com/lgustavoss/dx-connect/releases/download/desktop-windows/DeskRudder-Setup.exe;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
}
